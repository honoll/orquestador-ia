{
  "name": "orquestador-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "cd ui && npx vite",
    "build:ui": "cd ui && npx vite build",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit && cd ui && npx tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/node-ws": "^1.1.1",
    "@libsql/client": "^0.14.0",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.10",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.12.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
